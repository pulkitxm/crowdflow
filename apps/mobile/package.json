{
  "name": "crowdflow-spectator",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "bunx expo start",
    "web": "bunx expo start --web",
    "ios": "bunx expo start --ios",
    "android": "bunx expo start --android",
    "build": "expo export --platform android --output-dir dist",
    "lint": "biome lint App.tsx src modules/mesh/index.ts modules/mesh/bridge.test.ts metro.config.js vitest.config.mts index.js --diagnostic-level=error",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crowdflow/contracts": "0.2.0",
    "@crowdflow/core": "0.2.0",
    "@expo-google-fonts/barlow-semi-condensed": "^0.4.1",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.15",
    "expo-crypto": "~57.0.1",
    "expo-font": "^57.0.1",
    "expo-location": "~57.0.12",
    "expo-modules-core": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-wifi-reborn": "^4.13.6"
  },
  "devDependencies": {
    "@crowdflow/api": "workspace:*",
    "@types/react": "~19.2.4"
  }
}

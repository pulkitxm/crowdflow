{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "description": "CrowdFlow dashboard, simulator, API, and live WebSocket server.",
  "type": "module",
  "scripts": {
    "dev": "bun server.ts",
    "build": "next build --webpack",
    "lint": "biome lint app src server server-tests server.ts next.config.ts --diagnostic-level=error",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@crowdflow/agent": "0.2.0",
    "@crowdflow/cli": "0.2.0",
    "@crowdflow/contracts": "0.2.0",
    "@crowdflow/core": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.2",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1"
  }
}

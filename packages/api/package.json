{
  "name": "@crowdflow/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/wire.ts"
  },
  "bin": {
    "crowdflow-api": "./src/main.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts src/main.ts --outdir dist --target bun --packages external",
    "lint": "biome lint src tests --diagnostic-level=error",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crowdflow/agent": "0.2.0",
    "@crowdflow/contracts": "0.2.0",
    "@crowdflow/core": "0.2.0",
    "@crowdflow/cli": "0.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": { "@types/ws": "^8.18.1" }
}

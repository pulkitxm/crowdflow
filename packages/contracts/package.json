{
  "name": "@crowdflow/contracts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./standards": "./src/standards.ts",
    "./wire": "./src/wire.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts src/wire.ts --outdir dist --target bun --packages external",
    "codegen": "bun scripts/generate.ts",
    "lint": "biome lint src scripts tests --diagnostic-level=error",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0"
  }
}

{
  "$ref": "#/$defs/Zone",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Position": {
      "additionalProperties": false,
      "description": "A point in the venue's local metric frame, in metres.\n\nNever latitude/longitude. Lat/lon exists only at the circuit pack's origin and at the device's location adapter (plan.md section 10).",
      "properties": {
        "x": {
          "description": "metres east of venue origin",
          "type": "number"
        },
        "y": {
          "description": "metres north of venue origin",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Provenance": {
      "description": "Where a value came from. Never decorative — routing weights it.",
      "enum": [
        "osm",
        "venue_map",
        "f1_circuits",
        "authored",
        "measured",
        "assumed"
      ],
      "type": "string"
    },
    "Sourced": {
      "additionalProperties": false,
      "description": "A value with its provenance and, where applicable, its sample count.",
      "properties": {
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "samples": {
          "description": "observations behind a MEASURED value",
          "type": [
            "number",
            "null"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "description": "A named place. Imported from OSM tags where possible.",
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ZoneKind"
        },
        "name": {
          "description": "human-readable; the app uses this",
          "type": [
            "string",
            "null"
          ]
        },
        "osm_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "id",
        "kind",
        "position"
      ],
      "type": "object"
    },
    "ZoneKind": {
      "enum": [
        "gate",
        "concourse",
        "crossing",
        "viewing",
        "amenity",
        "parking",
        "exit"
      ],
      "type": "string"
    }
  }
}

{
  "$ref": "#/$defs/Step",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CrossingClosed": {
      "additionalProperties": false,
      "description": "Authored CrowdFlow wire contracts. Runtime derivations live beside them.",
      "properties": {
        "open": {
          "const": false,
          "type": "boolean"
        },
        "opens_at": {
          "description": "absolute unix seconds; None when no reopening time is known",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "open",
        "opens_at"
      ],
      "type": "object"
    },
    "CrossingNotice": {
      "additionalProperties": false,
      "description": "A timetable fact a spectator cannot infer by looking at the crossing.",
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossingOpen"
            },
            {
              "$ref": "#/$defs/CrossingClosed"
            }
          ]
        }
      },
      "required": [
        "name",
        "state"
      ],
      "type": "object"
    },
    "CrossingOpen": {
      "additionalProperties": false,
      "properties": {
        "closes_at": {
          "description": "absolute unix seconds; None when no closing time is known",
          "type": [
            "number",
            "null"
          ]
        },
        "open": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "open",
        "closes_at"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "description": "One already-priced leg of a route.",
      "properties": {
        "crossing": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossingNotice"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "to": {
          "description": "human-readable landmark from the circuit pack",
          "type": "string"
        },
        "walk_s": {
          "description": "walking seconds computed by the routing engine",
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        }
      },
      "required": [
        "id",
        "to",
        "walk_s",
        "way_ahead"
      ],
      "type": "object"
    },
    "WayAhead": {
      "enum": [
        "nominal",
        "building",
        "critical",
        "unknown"
      ],
      "type": "string"
    }
  }
}

{
  "$defs": {
    "AheadView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ahead",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "offer": {
          "$ref": "#/$defs/RerouteOffer"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "step_id": {
          "type": "string"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "step_id",
        "offer"
      ],
      "type": "object"
    },
    "ArrivalView": {
      "additionalProperties": false,
      "properties": {
        "gates": {
          "items": {
            "$ref": "#/$defs/GateChoice"
          },
          "type": "array"
        },
        "kind": {
          "const": "arrival",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "note": {
          "type": "string"
        },
        "now": {
          "type": "number"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "gates",
        "note"
      ],
      "type": "object"
    },
    "Availability": {
      "additionalProperties": false,
      "description": "When an edge exists at all (D5).\n\n`blocked: bool` cannot express \"open until quali, then closed for sixty minutes\". At-grade crossings close whenever cars are running, which makes routing time-dependent: a path is valid only if each edge is still open when the walker would actually reach it.",
      "properties": {
        "always_open": {
          "type": "boolean"
        },
        "close_lead_s": {
          "description": "closes this long before cars run",
          "type": "number"
        },
        "closed_when": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "open_when": {
          "description": "session states",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reopen_lag_s": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "CircuitPack": {
      "additionalProperties": false,
      "description": "One venue. Swapping circuits must require no code change.",
      "properties": {
        "altitude_m": {
          "type": "number"
        },
        "constraints": {
          "$ref": "#/$defs/SafetyConstraints"
        },
        "crossings": {
          "additionalProperties": {
            "$ref": "#/$defs/Crossing"
          },
          "type": "object"
        },
        "edges": {
          "additionalProperties": {
            "$ref": "#/$defs/Edge"
          },
          "type": "object"
        },
        "frame": {
          "$ref": "#/$defs/CoordinateFrame"
        },
        "geometry_source": {
          "description": "f1-circuits id, e.g. gb-1948",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "track_length_m": {
          "type": "number"
        },
        "zones": {
          "additionalProperties": {
            "$ref": "#/$defs/Zone"
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "geometry_source",
        "track_length_m",
        "altitude_m",
        "frame"
      ],
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "description": "How much to trust the state beside it.\n\nNever presented without the claim it qualifies. With thirty nodes reporting, the system says so; it does not quietly present the same number it would give for four hundred.",
      "properties": {
        "freshness_s": {
          "description": "age of the newest observation",
          "type": "number"
        },
        "mean_accuracy_m": {
          "description": "mean positional 1-sigma",
          "type": "number"
        },
        "observed_nodes": {
          "description": "devices contributing to this estimate",
          "type": "number"
        },
        "reportable": {
          "description": "The contract's served judgement; clients never restate its thresholds.",
          "type": "boolean"
        },
        "stability": {
          "description": "agreement with recent estimates for this zone",
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "observed_nodes",
        "freshness_s",
        "mean_accuracy_m",
        "stability",
        "reportable"
      ],
      "type": "object"
    },
    "CoordinateFrame": {
      "additionalProperties": false,
      "description": "Local metric frame. Derived from the source bbox, never estimated.",
      "properties": {
        "origin_lat": {
          "type": "number"
        },
        "origin_lon": {
          "type": "number"
        },
        "rotation_deg": {
          "type": "number"
        },
        "track_bounds_m": {
          "description": "track extent (x, y)",
          "items": {},
          "type": "array"
        },
        "venue_bounds_m": {
          "description": "(min_x, min_y, max_x, max_y). Larger than the track: car parks, campsites and park-and-ride sit outside it. Sizing to the track clips arrival routes.",
          "items": {},
          "type": "array"
        }
      },
      "required": [
        "origin_lat",
        "origin_lon",
        "track_bounds_m",
        "venue_bounds_m"
      ],
      "type": "object"
    },
    "Crossing": {
      "additionalProperties": false,
      "description": "The dominant bottleneck mechanism at a circuit.\n\nBridges and tunnels stay open but carry far less than the at-grade crossings they replace — which is exactly why they pinch when a session starts.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "edge_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CrossingKind"
        },
        "throughput_per_min": {
          "$ref": "#/$defs/Sourced"
        }
      },
      "required": [
        "id",
        "kind",
        "edge_id",
        "throughput_per_min"
      ],
      "type": "object"
    },
    "CrossingClosed": {
      "additionalProperties": false,
      "description": "Authored CrowdFlow wire contracts. Runtime derivations live beside them.",
      "properties": {
        "open": {
          "const": false,
          "type": "boolean"
        },
        "opens_at": {
          "description": "absolute unix seconds; None when no reopening time is known",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "open",
        "opens_at"
      ],
      "type": "object"
    },
    "CrossingNotice": {
      "additionalProperties": false,
      "description": "A timetable fact a spectator cannot infer by looking at the crossing.",
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossingOpen"
            },
            {
              "$ref": "#/$defs/CrossingClosed"
            }
          ]
        }
      },
      "required": [
        "name",
        "state"
      ],
      "type": "object"
    },
    "CrossingOpen": {
      "additionalProperties": false,
      "properties": {
        "closes_at": {
          "description": "absolute unix seconds; None when no closing time is known",
          "type": [
            "number",
            "null"
          ]
        },
        "open": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "open",
        "closes_at"
      ],
      "type": "object"
    },
    "CrowdNode": {
      "additionalProperties": false,
      "description": "One anonymous device's live movement state.\n\nnode_id is a rotating pseudonym, not an identity. It is valid only within its rotation epoch and must never be joined across epochs.",
      "properties": {
        "accuracy_m": {
          "description": "positional 1-sigma; feeds the confidence model",
          "type": "number"
        },
        "epoch": {
          "description": "ID rotation epoch; IDs are not comparable across epochs",
          "type": "number"
        },
        "heading_deg": {
          "description": "degrees clockwise from north",
          "type": "number"
        },
        "node_id": {
          "description": "rotating pseudonym, valid within its epoch only",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "speed_ms": {
          "description": "metres per second",
          "type": "number"
        },
        "timestamp": {
          "description": "unix seconds",
          "type": "number"
        },
        "zone_id": {
          "description": "assigned by the state engine, not self-reported",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "node_id",
        "epoch",
        "timestamp",
        "position",
        "speed_ms",
        "heading_deg",
        "accuracy_m"
      ],
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "A walkable connection.\n\nwidth_m matters more than it looks: flow rate is per metre of width, so the LOS band cannot be computed without it.",
      "properties": {
        "bidirectional": {
          "type": "boolean"
        },
        "capacity_flow_ped_m_min": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ],
          "description": "observed peak sustained flow per metre of width; never invented"
        },
        "destination": {
          "type": "string"
        },
        "free_speed_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ],
          "description": "observed where available, else the standards prior"
        },
        "gradient": {
          "description": "rise over run; affects walking speed",
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "length_m": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "width_m": {
          "$ref": "#/$defs/Sourced",
          "description": "required — LOS flow is per metre of width"
        }
      },
      "required": [
        "id",
        "source",
        "destination",
        "length_m",
        "width_m"
      ],
      "type": "object"
    },
    "EventProfile": {
      "additionalProperties": false,
      "description": "This weekend's timetable. Changes every event; the circuit does not.\n\nThe chequered flag is the largest crowd-movement trigger of the day, so this feeds the predictor directly, not just the display.",
      "properties": {
        "circuit_id": {
          "type": "string"
        },
        "gates_open": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/Session"
          },
          "type": "array"
        }
      },
      "required": [
        "circuit_id",
        "name"
      ],
      "type": "object"
    },
    "Forecast": {
      "additionalProperties": false,
      "description": "Where congestion will be, when, and why.\n\nThe headline is time_to_threshold_s, not the current value. \"2:47 until capacity\" drives a decision; \"87% full\" does not.",
      "properties": {
        "actionable": {
          "description": "Served judgement: clients must not duplicate these thresholds.",
          "type": "boolean"
        },
        "causes": {
          "description": "human-readable drivers, ordered by contribution",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confidence": {
          "type": "number"
        },
        "horizon_s": {
          "description": "how far ahead this forecast looks",
          "type": "number"
        },
        "issued_at": {
          "type": "number"
        },
        "model_id": {
          "description": "which model produced this; baseline is a valid answer",
          "type": "string"
        },
        "probability": {
          "type": "number"
        },
        "projected_peak_density_persons_m2": {
          "description": "persons/m2 at the projected peak; bands are classified on density",
          "type": "number"
        },
        "target_band": {
          "$ref": "#/$defs/LOSBand",
          "description": "the band predicted to be crossed"
        },
        "time_to_threshold_s": {
          "description": "None when the threshold is not projected to be crossed",
          "type": [
            "number",
            "null"
          ]
        },
        "zone_id": {
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "issued_at",
        "horizon_s",
        "target_band",
        "probability",
        "projected_peak_density_persons_m2",
        "confidence",
        "model_id",
        "actionable"
      ],
      "type": "object"
    },
    "GateChoice": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "walk_s": {
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        },
        "zone_id": {
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "name",
        "walk_s",
        "way_ahead"
      ],
      "type": "object"
    },
    "HoldView": {
      "additionalProperties": false,
      "properties": {
        "because": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "kind": {
          "const": "hold",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/LeaveOption"
          },
          "type": "array"
        },
        "recommended_id": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "options",
        "recommended_id",
        "headline",
        "because"
      ],
      "type": "object"
    },
    "InterventionCandidate": {
      "additionalProperties": false,
      "description": "One simulated what-if. Rejected candidates are kept and displayed.",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "description": {
          "description": "plain language, e.g. 'Divert 30% of Vale to Gate 4'",
          "type": "string"
        },
        "divert_fraction": {
          "description": "0.0 is the do-nothing baseline",
          "type": "number"
        },
        "from_zone": {
          "type": "string"
        },
        "projected_bottleneck_duration_s": {
          "type": "number"
        },
        "projected_peak_density_persons_m2": {
          "description": "persons/m2 at the projected peak",
          "type": "number"
        },
        "projected_walk_time_delta_s": {
          "description": "positive means longer. Always shown beside the benefit, never hidden.",
          "type": "number"
        },
        "score": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "selected": {
          "type": "boolean"
        },
        "to_zone": {
          "type": "string"
        },
        "via": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "description",
        "divert_fraction",
        "from_zone",
        "to_zone",
        "projected_peak_density_persons_m2",
        "projected_walk_time_delta_s",
        "projected_bottleneck_duration_s",
        "score"
      ],
      "type": "object"
    },
    "LeaveOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommendation_note": {
          "description": "engine-authored reason this option is recommended; absent otherwise",
          "type": [
            "string",
            "null"
          ]
        },
        "spent": {
          "type": "string"
        },
        "total_s": {
          "description": "door-to-car seconds, including any wait",
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        }
      },
      "required": [
        "id",
        "label",
        "total_s",
        "way_ahead",
        "spent"
      ],
      "type": "object"
    },
    "LinkStatus": {
      "additionalProperties": false,
      "description": "Freshness and reachability, stated rather than hidden.",
      "properties": {
        "mesh_peers": {
          "type": "number"
        },
        "online": {
          "type": "boolean"
        },
        "updated_at": {
          "description": "unix seconds of the newest observation behind the route",
          "type": "number"
        }
      },
      "required": [
        "online",
        "mesh_peers",
        "updated_at"
      ],
      "type": "object"
    },
    "MeshMessage": {
      "additionalProperties": false,
      "description": "Envelope for anything crossing the mesh.\n\nsequence prevents duplicate processing; ttl stops packets travelling forever. Both are enforced at every hop, not just at the destination.",
      "properties": {
        "payload": {
          "additionalProperties": {},
          "type": "object"
        },
        "sequence": {
          "description": "per-source monotonic; used for dedupe",
          "type": "number"
        },
        "source": {
          "description": "rotating node pseudonym of the originator",
          "type": "string"
        },
        "timestamp": {
          "type": "number"
        },
        "traffic_class": {
          "$ref": "#/$defs/MeshClass"
        },
        "ttl": {
          "description": "hops remaining",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/MeshMessageType"
        }
      },
      "required": [
        "type",
        "traffic_class",
        "source",
        "sequence",
        "ttl",
        "timestamp"
      ],
      "type": "object"
    },
    "OfflineView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "offline",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind"
      ],
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "A point in the venue's local metric frame, in metres.\n\nNever latitude/longitude. Lat/lon exists only at the circuit pack's origin and at the device's location adapter (plan.md section 10).",
      "properties": {
        "x": {
          "description": "metres east of venue origin",
          "type": "number"
        },
        "y": {
          "description": "metres north of venue origin",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "RerouteCommand": {
      "additionalProperties": false,
      "description": "What actually goes over the mesh.\n\nDeliberately NOT a per-person route. Broadcasting avoid/prefer sets and letting each device compute its own path scales, and works offline (plan.md section 33).",
      "properties": {
        "avoid": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command_id": {
          "type": "string"
        },
        "destination_zone": {
          "type": "string"
        },
        "expected_cost_s": {
          "description": "honest added walking time, stated before the user accepts",
          "type": "number"
        },
        "expires_at": {
          "description": "commands must expire; stale routing is harmful",
          "type": "number"
        },
        "issued_at": {
          "type": "number"
        },
        "prefer": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "plain language, surfaced in the app",
          "type": "string"
        },
        "source_zone": {
          "type": "string"
        },
        "target_fraction": {
          "description": "share of affected walkers this should reach",
          "type": "number"
        }
      },
      "required": [
        "command_id",
        "issued_at",
        "expires_at",
        "source_zone",
        "destination_zone",
        "target_fraction",
        "reason",
        "expected_cost_s"
      ],
      "type": "object"
    },
    "RerouteOffer": {
      "additionalProperties": false,
      "description": "A proposed alternative and the safety verdict that gates its display.",
      "properties": {
        "command": {
          "$ref": "#/$defs/RerouteCommand"
        },
        "instead": {
          "$ref": "#/$defs/Route"
        },
        "verdict": {
          "$ref": "#/$defs/SafetyVerdict"
        }
      },
      "required": [
        "command",
        "verdict",
        "instead"
      ],
      "type": "object"
    },
    "ReroutedView": {
      "additionalProperties": false,
      "properties": {
        "added_s": {
          "type": "number"
        },
        "instead_of": {
          "$ref": "#/$defs/Route"
        },
        "kind": {
          "const": "rerouted",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "instead_of",
        "added_s",
        "reason"
      ],
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "description": "Where the spectator is, where they are going and the walk between them.",
      "properties": {
        "from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "to": {
          "type": "string"
        },
        "total_walk_s": {
          "description": "door-to-door seconds from routing, including waits; never summed on the phone",
          "type": "number"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "steps",
        "total_walk_s"
      ],
      "type": "object"
    },
    "SafetyConstraints": {
      "additionalProperties": false,
      "description": "Hard rules the agent cannot override.",
      "properties": {
        "accessible_routes": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "emergency_exits": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "never_route_through": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SafetyVerdict": {
      "additionalProperties": false,
      "description": "The gate every action passes through.\n\nHard constraints the AI cannot override: never route through a blocked or forbidden edge, never intentionally exceed capacity, never route away from emergency exits during evacuation (plan.md section 34).",

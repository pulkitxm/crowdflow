{
  "$ref": "#/$defs/LeaveOption",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LeaveOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommendation_note": {
          "description": "engine-authored reason this option is recommended; absent otherwise",
          "type": [
            "string",
            "null"
          ]
        },
        "spent": {
          "type": "string"
        },
        "total_s": {
          "description": "door-to-car seconds, including any wait",
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        }
      },
      "required": [
        "id",
        "label",
        "total_s",
        "way_ahead",
        "spent"
      ],
      "type": "object"
    },
    "WayAhead": {
      "enum": [
        "nominal",
        "building",
        "critical",
        "unknown"
      ],
      "type": "string"
    }
  }
}

{
  "$ref": "#/$defs/EventProfile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EventProfile": {
      "additionalProperties": false,
      "description": "This weekend's timetable. Changes every event; the circuit does not.\n\nThe chequered flag is the largest crowd-movement trigger of the day, so this feeds the predictor directly, not just the display.",
      "properties": {
        "circuit_id": {
          "type": "string"
        },
        "gates_open": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/Session"
          },
          "type": "array"
        }
      },
      "required": [
        "circuit_id",
        "name"
      ],
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "practice | qualifying | sprint | race | support | ceremony",
          "type": "string"
        },
        "start": {
          "description": "ISO 8601",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "start",
        "end"
      ],
      "type": "object"
    }
  }
}

{
  "$ref": "#/$defs/InterventionCandidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "InterventionCandidate": {
      "additionalProperties": false,
      "description": "One simulated what-if. Rejected candidates are kept and displayed.",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "description": {
          "description": "plain language, e.g. 'Divert 30% of Vale to Gate 4'",
          "type": "string"
        },
        "divert_fraction": {
          "description": "0.0 is the do-nothing baseline",
          "type": "number"
        },
        "from_zone": {
          "type": "string"
        },
        "projected_bottleneck_duration_s": {
          "type": "number"
        },
        "projected_peak_density_persons_m2": {
          "description": "persons/m2 at the projected peak",
          "type": "number"
        },
        "projected_walk_time_delta_s": {
          "description": "positive means longer. Always shown beside the benefit, never hidden.",
          "type": "number"
        },
        "score": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "selected": {
          "type": "boolean"
        },
        "to_zone": {
          "type": "string"
        },
        "via": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "description",
        "divert_fraction",
        "from_zone",
        "to_zone",
        "projected_peak_density_persons_m2",
        "projected_walk_time_delta_s",
        "projected_bottleneck_duration_s",
        "score"
      ],
      "type": "object"
    },
    "ScoreBreakdown": {
      "additionalProperties": false,
      "description": "Why a candidate scored what it did.\n\nShown to the operator. An intervention recommendation without its components is an assertion; with them it is an argument.",
      "properties": {
        "capacity_headroom": {
          "type": "number"
        },
        "congestion_reduction": {
          "type": "number"
        },
        "fairness": {
          "type": "number"
        },
        "safety_margin": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "walk_time_cost": {
          "type": "number"
        }
      },
      "required": [
        "congestion_reduction",
        "walk_time_cost",
        "capacity_headroom",
        "safety_margin",
        "fairness",
        "total"
      ],
      "type": "object"
    }
  }
}

{
  "$defs": {
    "Availability": {
      "description": "When an edge exists at all (D5).\n\n`blocked: bool` cannot express \"open until quali, then closed for sixty\nminutes\". At-grade crossings close whenever cars are running, which makes\nrouting time-dependent: a path is valid only if each edge is still open when\nthe walker would actually reach it.",
      "properties": {
        "always_open": {
          "default": true,
          "title": "Always Open",
          "type": "boolean"
        },
        "open_when": {
          "description": "session states",
          "items": {
            "type": "string"
          },
          "title": "Open When",
          "type": "array"
        },
        "closed_when": {
          "items": {
            "type": "string"
          },
          "title": "Closed When",
          "type": "array"
        },
        "close_lead_s": {
          "default": 0,
          "description": "closes this long before cars run",
          "title": "Close Lead S",
          "type": "number"
        },
        "reopen_lag_s": {
          "default": 0,
          "title": "Reopen Lag S",
          "type": "number"
        }
      },
      "title": "Availability",
      "type": "object"
    },
    "CoordinateFrame": {
      "description": "Local metric frame. Derived from the source bbox, never estimated.",
      "properties": {
        "origin_lat": {
          "title": "Origin Lat",
          "type": "number"
        },
        "origin_lon": {
          "title": "Origin Lon",
          "type": "number"
        },
        "rotation_deg": {
          "default": 0.0,
          "title": "Rotation Deg",
          "type": "number"
        },
        "track_bounds_m": {
          "description": "track extent (x, y)",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Track Bounds M",
          "type": "array"
        },
        "venue_bounds_m": {
          "description": "(min_x, min_y, max_x, max_y). Larger than the track: car parks, campsites and park-and-ride sit outside it. Sizing to the track clips arrival routes.",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Venue Bounds M",
          "type": "array"
        }
      },
      "required": [
        "origin_lat",
        "origin_lon",
        "track_bounds_m",
        "venue_bounds_m"
      ],
      "title": "CoordinateFrame",
      "type": "object"
    },
    "Crossing": {
      "description": "The dominant bottleneck mechanism at a circuit.\n\nBridges and tunnels stay open but carry far less than the at-grade crossings\nthey replace \u2014 which is exactly why they pinch when a session starts.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CrossingKind"
        },
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "throughput_per_min": {
          "$ref": "#/$defs/Sourced"
        },
        "availability": {
          "$ref": "#/$defs/Availability"
        }
      },
      "required": [
        "id",
        "kind",
        "edge_id",
        "throughput_per_min"
      ],
      "title": "Crossing",
      "type": "object"
    },
    "CrossingKind": {
      "enum": [
        "bridge",
        "tunnel",
        "at_grade"
      ],
      "title": "CrossingKind",
      "type": "string"
    },
    "Edge": {
      "description": "A walkable connection.\n\nwidth_m matters more than it looks: flow rate is per metre of width, so the\nLOS band cannot be computed without it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "destination": {
          "title": "Destination",
          "type": "string"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "width_m": {
          "$ref": "#/$defs/Sourced",
          "description": "required \u2014 LOS flow is per metre of width"
        },
        "gradient": {
          "default": 0.0,
          "description": "rise over run; affects walking speed",
          "title": "Gradient",
          "type": "number"
        },
        "bidirectional": {
          "default": true,
          "title": "Bidirectional",
          "type": "boolean"
        },
        "free_speed_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "observed where available, else the standards prior"
        },
        "capacity_flow_ped_m_min": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "observed peak sustained flow per metre of width; never invented"
        }
      },
      "required": [
        "id",
        "source",
        "destination",
        "length_m",
        "width_m"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Position": {
      "description": "A point in the venue's local metric frame, in metres.\n\nNever latitude/longitude. Lat/lon exists only at the circuit pack's origin and\nat the device's location adapter (plan.md section 10).",
      "properties": {
        "x": {
          "description": "metres east of venue origin",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "metres north of venue origin",
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "Provenance": {
      "description": "Where a value came from. Never decorative \u2014 routing weights it.",
      "enum": [
        "osm",
        "venue_map",
        "f1_circuits",
        "authored",
        "measured",
        "assumed"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "SafetyConstraints": {
      "description": "Hard rules the agent cannot override.",
      "properties": {
        "never_route_through": {
          "items": {
            "type": "string"
          },
          "title": "Never Route Through",
          "type": "array"
        },
        "emergency_exits": {
          "items": {
            "type": "string"
          },
          "title": "Emergency Exits",
          "type": "array"
        },
        "accessible_routes": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Accessible Routes",
          "type": "array"
        }
      },
      "title": "SafetyConstraints",
      "type": "object"
    },
    "Sourced": {
      "description": "A value with its provenance and, where applicable, its sample count.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "observations behind a MEASURED value",
          "title": "Samples"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "title": "Sourced",
      "type": "object"
    },
    "Zone": {
      "description": "A named place. Imported from OSM tags where possible.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ZoneKind"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "human-readable; the app uses this",
          "title": "Name"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "capacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "osm_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Osm Id"
        }
      },
      "required": [
        "id",
        "kind",
        "position"
      ],
      "title": "Zone",
      "type": "object"
    },
    "ZoneKind": {
      "enum": [
        "gate",
        "concourse",
        "crossing",
        "viewing",
        "amenity",
        "parking",
        "exit"
      ],
      "title": "ZoneKind",
      "type": "string"
    }
  },
  "description": "One venue. Swapping circuits must require no code change.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "geometry_source": {
      "description": "f1-circuits id, e.g. gb-1948",
      "title": "Geometry Source",
      "type": "string"
    },
    "track_length_m": {
      "title": "Track Length M",
      "type": "number"
    },
    "altitude_m": {
      "title": "Altitude M",
      "type": "number"
    },
    "frame": {
      "$ref": "#/$defs/CoordinateFrame"
    },
    "zones": {
      "additionalProperties": {
        "$ref": "#/$defs/Zone"
      },
      "title": "Zones",
      "type": "object"
    },
    "edges": {
      "additionalProperties": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "object"
    },
    "crossings": {
      "additionalProperties": {
        "$ref": "#/$defs/Crossing"
      },
      "title": "Crossings",
      "type": "object"
    },
    "constraints": {
      "$ref": "#/$defs/SafetyConstraints"
    }
  },
  "required": [
    "id",
    "name",
    "geometry_source",
    "track_length_m",
    "altitude_m",
    "frame"
  ],
  "title": "CircuitPack",
  "type": "object"
}

{
  "$ref": "#/$defs/CircuitPack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "description": "When an edge exists at all (D5).\n\n`blocked: bool` cannot express \"open until quali, then closed for sixty minutes\". At-grade crossings close whenever cars are running, which makes routing time-dependent: a path is valid only if each edge is still open when the walker would actually reach it.",
      "properties": {
        "always_open": {
          "type": "boolean"
        },
        "close_lead_s": {
          "description": "closes this long before cars run",
          "type": "number"
        },
        "closed_when": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "open_when": {
          "description": "session states",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reopen_lag_s": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "CircuitPack": {
      "additionalProperties": false,
      "description": "One venue. Swapping circuits must require no code change.",
      "properties": {
        "altitude_m": {
          "type": "number"
        },
        "constraints": {
          "$ref": "#/$defs/SafetyConstraints"
        },
        "crossings": {
          "additionalProperties": {
            "$ref": "#/$defs/Crossing"
          },
          "type": "object"
        },
        "edges": {
          "additionalProperties": {
            "$ref": "#/$defs/Edge"
          },
          "type": "object"
        },
        "frame": {
          "$ref": "#/$defs/CoordinateFrame"
        },
        "geometry_source": {
          "description": "f1-circuits id, e.g. gb-1948",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "track_length_m": {
          "type": "number"
        },
        "zones": {
          "additionalProperties": {
            "$ref": "#/$defs/Zone"
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "geometry_source",
        "track_length_m",
        "altitude_m",
        "frame"
      ],
      "type": "object"
    },
    "CoordinateFrame": {
      "additionalProperties": false,
      "description": "Local metric frame. Derived from the source bbox, never estimated.",
      "properties": {
        "origin_lat": {
          "type": "number"
        },
        "origin_lon": {
          "type": "number"
        },
        "rotation_deg": {
          "type": "number"
        },
        "track_bounds_m": {
          "description": "track extent (x, y)",
          "items": {},
          "type": "array"
        },
        "venue_bounds_m": {
          "description": "(min_x, min_y, max_x, max_y). Larger than the track: car parks, campsites and park-and-ride sit outside it. Sizing to the track clips arrival routes.",
          "items": {},
          "type": "array"
        }
      },
      "required": [
        "origin_lat",
        "origin_lon",
        "track_bounds_m",
        "venue_bounds_m"
      ],
      "type": "object"
    },
    "Crossing": {
      "additionalProperties": false,
      "description": "The dominant bottleneck mechanism at a circuit.\n\nBridges and tunnels stay open but carry far less than the at-grade crossings they replace — which is exactly why they pinch when a session starts.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "edge_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CrossingKind"
        },
        "throughput_per_min": {
          "$ref": "#/$defs/Sourced"
        }
      },
      "required": [
        "id",
        "kind",
        "edge_id",
        "throughput_per_min"
      ],
      "type": "object"
    },
    "CrossingKind": {
      "enum": [
        "bridge",
        "tunnel",
        "at_grade"
      ],
      "type": "string"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "A walkable connection.\n\nwidth_m matters more than it looks: flow rate is per metre of width, so the LOS band cannot be computed without it.",
      "properties": {
        "bidirectional": {
          "type": "boolean"
        },
        "capacity_flow_ped_m_min": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ],
          "description": "observed peak sustained flow per metre of width; never invented"
        },
        "destination": {
          "type": "string"
        },
        "free_speed_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ],
          "description": "observed where available, else the standards prior"
        },
        "gradient": {
          "description": "rise over run; affects walking speed",
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "length_m": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "width_m": {
          "$ref": "#/$defs/Sourced",
          "description": "required — LOS flow is per metre of width"
        }
      },
      "required": [
        "id",
        "source",
        "destination",
        "length_m",
        "width_m"
      ],
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "A point in the venue's local metric frame, in metres.\n\nNever latitude/longitude. Lat/lon exists only at the circuit pack's origin and at the device's location adapter (plan.md section 10).",
      "properties": {
        "x": {
          "description": "metres east of venue origin",
          "type": "number"
        },
        "y": {
          "description": "metres north of venue origin",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Provenance": {
      "description": "Where a value came from. Never decorative — routing weights it.",
      "enum": [
        "osm",
        "venue_map",
        "f1_circuits",
        "authored",
        "measured",
        "assumed"
      ],
      "type": "string"
    },
    "SafetyConstraints": {
      "additionalProperties": false,
      "description": "Hard rules the agent cannot override.",
      "properties": {
        "accessible_routes": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "emergency_exits": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "never_route_through": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Sourced": {
      "additionalProperties": false,
      "description": "A value with its provenance and, where applicable, its sample count.",
      "properties": {
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "samples": {
          "description": "observations behind a MEASURED value",
          "type": [
            "number",
            "null"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "description": "A named place. Imported from OSM tags where possible.",
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sourced"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ZoneKind"
        },
        "name": {
          "description": "human-readable; the app uses this",
          "type": [
            "string",
            "null"
          ]
        },
        "osm_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "id",
        "kind",
        "position"
      ],
      "type": "object"
    },
    "ZoneKind": {
      "enum": [
        "gate",
        "concourse",
        "crossing",
        "viewing",
        "amenity",
        "parking",
        "exit"
      ],
      "type": "string"
    }
  }
}

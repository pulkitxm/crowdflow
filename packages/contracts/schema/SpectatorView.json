{
  "$ref": "#/$defs/SpectatorView",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AheadView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ahead",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "offer": {
          "$ref": "#/$defs/RerouteOffer"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "step_id": {
          "type": "string"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "step_id",
        "offer"
      ],
      "type": "object"
    },
    "ArrivalView": {
      "additionalProperties": false,
      "properties": {
        "gates": {
          "items": {
            "$ref": "#/$defs/GateChoice"
          },
          "type": "array"
        },
        "kind": {
          "const": "arrival",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "note": {
          "type": "string"
        },
        "now": {
          "type": "number"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "gates",
        "note"
      ],
      "type": "object"
    },
    "CrossingClosed": {
      "additionalProperties": false,
      "description": "Authored CrowdFlow wire contracts. Runtime derivations live beside them.",
      "properties": {
        "open": {
          "const": false,
          "type": "boolean"
        },
        "opens_at": {
          "description": "absolute unix seconds; None when no reopening time is known",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "open",
        "opens_at"
      ],
      "type": "object"
    },
    "CrossingNotice": {
      "additionalProperties": false,
      "description": "A timetable fact a spectator cannot infer by looking at the crossing.",
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossingOpen"
            },
            {
              "$ref": "#/$defs/CrossingClosed"
            }
          ]
        }
      },
      "required": [
        "name",
        "state"
      ],
      "type": "object"
    },
    "CrossingOpen": {
      "additionalProperties": false,
      "properties": {
        "closes_at": {
          "description": "absolute unix seconds; None when no closing time is known",
          "type": [
            "number",
            "null"
          ]
        },
        "open": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "open",
        "closes_at"
      ],
      "type": "object"
    },
    "GateChoice": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "walk_s": {
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        },
        "zone_id": {
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "name",
        "walk_s",
        "way_ahead"
      ],
      "type": "object"
    },
    "HoldView": {
      "additionalProperties": false,
      "properties": {
        "because": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "kind": {
          "const": "hold",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/LeaveOption"
          },
          "type": "array"
        },
        "recommended_id": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "options",
        "recommended_id",
        "headline",
        "because"
      ],
      "type": "object"
    },
    "LeaveOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "recommendation_note": {
          "description": "engine-authored reason this option is recommended; absent otherwise",
          "type": [
            "string",
            "null"
          ]
        },
        "spent": {
          "type": "string"
        },
        "total_s": {
          "description": "door-to-car seconds, including any wait",
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        }
      },
      "required": [
        "id",
        "label",
        "total_s",
        "way_ahead",
        "spent"
      ],
      "type": "object"
    },
    "LinkStatus": {
      "additionalProperties": false,
      "description": "Freshness and reachability, stated rather than hidden.",
      "properties": {
        "mesh_peers": {
          "type": "number"
        },
        "online": {
          "type": "boolean"
        },
        "updated_at": {
          "description": "unix seconds of the newest observation behind the route",
          "type": "number"
        }
      },
      "required": [
        "online",
        "mesh_peers",
        "updated_at"
      ],
      "type": "object"
    },
    "OfflineView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "offline",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind"
      ],
      "type": "object"
    },
    "RerouteCommand": {
      "additionalProperties": false,
      "description": "What actually goes over the mesh.\n\nDeliberately NOT a per-person route. Broadcasting avoid/prefer sets and letting each device compute its own path scales, and works offline (plan.md section 33).",
      "properties": {
        "avoid": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command_id": {
          "type": "string"
        },
        "destination_zone": {
          "type": "string"
        },
        "expected_cost_s": {
          "description": "honest added walking time, stated before the user accepts",
          "type": "number"
        },
        "expires_at": {
          "description": "commands must expire; stale routing is harmful",
          "type": "number"
        },
        "issued_at": {
          "type": "number"
        },
        "prefer": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "plain language, surfaced in the app",
          "type": "string"
        },
        "source_zone": {
          "type": "string"
        },
        "target_fraction": {
          "description": "share of affected walkers this should reach",
          "type": "number"
        }
      },
      "required": [
        "command_id",
        "issued_at",
        "expires_at",
        "source_zone",
        "destination_zone",
        "target_fraction",
        "reason",
        "expected_cost_s"
      ],
      "type": "object"
    },
    "RerouteOffer": {
      "additionalProperties": false,
      "description": "A proposed alternative and the safety verdict that gates its display.",
      "properties": {
        "command": {
          "$ref": "#/$defs/RerouteCommand"
        },
        "instead": {
          "$ref": "#/$defs/Route"
        },
        "verdict": {
          "$ref": "#/$defs/SafetyVerdict"
        }
      },
      "required": [
        "command",
        "verdict",
        "instead"
      ],
      "type": "object"
    },
    "ReroutedView": {
      "additionalProperties": false,
      "properties": {
        "added_s": {
          "type": "number"
        },
        "instead_of": {
          "$ref": "#/$defs/Route"
        },
        "kind": {
          "const": "rerouted",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "instead_of",
        "added_s",
        "reason"
      ],
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "description": "Where the spectator is, where they are going and the walk between them.",
      "properties": {
        "from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "to": {
          "type": "string"
        },
        "total_walk_s": {
          "description": "door-to-door seconds from routing, including waits; never summed on the phone",
          "type": "number"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "steps",
        "total_walk_s"
      ],
      "type": "object"
    },
    "SafetyOutcome": {
      "enum": [
        "approved",
        "rejected",
        "modified"
      ],
      "type": "string"
    },
    "SafetyVerdict": {
      "additionalProperties": false,
      "description": "The gate every action passes through.\n\nHard constraints the AI cannot override: never route through a blocked or forbidden edge, never intentionally exceed capacity, never route away from emergency exits during evacuation (plan.md section 34).",
      "properties": {
        "command_id": {
          "type": "string"
        },
        "dispatchable": {
          "description": "Only the exact command reviewed as APPROVED may leave the gate.\n\n``MODIFIED`` describes a rejected proposal for which safety can suggest a correction; it does not contain that corrected command. Dispatching the original in that state would act on the version safety changed. A corrected command must be issued separately and reviewed in full.",
          "type": "boolean"
        },
        "emergency_mode": {
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/SafetyOutcome"
        },
        "reason": {
          "description": "stated even on approval; rejections are explained",
          "type": "string"
        },
        "unchecked_constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "violated_constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "command_id",
        "outcome",
        "reason",
        "dispatchable"
      ],
      "type": "object"
    },
    "SpectatorView": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArrivalView"
        },
        {
          "$ref": "#/$defs/WalkView"
        },
        {
          "$ref": "#/$defs/AheadView"
        },
        {
          "$ref": "#/$defs/ReroutedView"
        },
        {
          "$ref": "#/$defs/OfflineView"
        },
        {
          "$ref": "#/$defs/HoldView"
        }
      ],
      "description": "One of the six screen states for a race day."
    },
    "Step": {
      "additionalProperties": false,
      "description": "One already-priced leg of a route.",
      "properties": {
        "crossing": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossingNotice"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "to": {
          "description": "human-readable landmark from the circuit pack",
          "type": "string"
        },
        "walk_s": {
          "description": "walking seconds computed by the routing engine",
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        }
      },
      "required": [
        "id",
        "to",
        "walk_s",
        "way_ahead"
      ],
      "type": "object"
    },
    "WalkView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "walk",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "now": {
          "type": "number"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind"
      ],
      "type": "object"
    },
    "WayAhead": {
      "enum": [
        "nominal",
        "building",
        "critical",
        "unknown"
      ],
      "type": "string"
    }
  }
}

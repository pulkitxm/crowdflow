{
  "$ref": "#/$defs/GateChoice",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GateChoice": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "walk_s": {
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        },
        "zone_id": {
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "name",
        "walk_s",
        "way_ahead"
      ],
      "type": "object"
    },
    "WayAhead": {
      "enum": [
        "nominal",
        "building",
        "critical",
        "unknown"
      ],
      "type": "string"
    }
  }
}

{
  "$ref": "#/$defs/LinkStatus",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "LinkStatus": {
      "additionalProperties": false,
      "description": "Freshness and reachability, stated rather than hidden.",
      "properties": {
        "mesh_peers": {
          "type": "number"
        },
        "online": {
          "type": "boolean"
        },
        "updated_at": {
          "description": "unix seconds of the newest observation behind the route",
          "type": "number"
        }
      },
      "required": [
        "online",
        "mesh_peers",
        "updated_at"
      ],
      "type": "object"
    }
  }
}

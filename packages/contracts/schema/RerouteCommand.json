{
  "$ref": "#/$defs/RerouteCommand",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RerouteCommand": {
      "additionalProperties": false,
      "description": "What actually goes over the mesh.\n\nDeliberately NOT a per-person route. Broadcasting avoid/prefer sets and letting each device compute its own path scales, and works offline (plan.md section 33).",
      "properties": {
        "avoid": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command_id": {
          "type": "string"
        },
        "destination_zone": {
          "type": "string"
        },
        "expected_cost_s": {
          "description": "honest added walking time, stated before the user accepts",
          "type": "number"
        },
        "expires_at": {
          "description": "commands must expire; stale routing is harmful",
          "type": "number"
        },
        "issued_at": {
          "type": "number"
        },
        "prefer": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "plain language, surfaced in the app",
          "type": "string"
        },
        "source_zone": {
          "type": "string"
        },
        "target_fraction": {
          "description": "share of affected walkers this should reach",
          "type": "number"
        }
      },
      "required": [
        "command_id",
        "issued_at",
        "expires_at",
        "source_zone",
        "destination_zone",
        "target_fraction",
        "reason",
        "expected_cost_s"
      ],
      "type": "object"
    }
  }
}

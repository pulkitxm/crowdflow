{
  "$ref": "#/$defs/CrossingOpen",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CrossingOpen": {
      "additionalProperties": false,
      "properties": {
        "closes_at": {
          "description": "absolute unix seconds; None when no closing time is known",
          "type": [
            "number",
            "null"
          ]
        },
        "open": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "open",
        "closes_at"
      ],
      "type": "object"
    }
  }
}

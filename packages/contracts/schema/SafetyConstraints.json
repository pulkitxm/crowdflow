            "type": "array"
          },
          "type": "array"
        },
        "emergency_exits": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "never_route_edges": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "never_route_through": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  }
}

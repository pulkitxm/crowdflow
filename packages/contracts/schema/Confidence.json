{
  "$ref": "#/$defs/Confidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "description": "How much to trust the state beside it.\n\nNever presented without the claim it qualifies. With thirty nodes reporting, the system says so; it does not quietly present the same number it would give for four hundred.",
      "properties": {
        "freshness_s": {
          "description": "age of the newest observation",
          "type": "number"
        },
        "mean_accuracy_m": {
          "description": "mean positional 1-sigma",
          "type": "number"
        },
        "observed_nodes": {
          "description": "devices contributing to this estimate",
          "type": "number"
        },
        "reportable": {
          "description": "The contract's served judgement; clients never restate its thresholds.",
          "type": "boolean"
        },
        "stability": {
          "description": "agreement with recent estimates for this zone",
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "observed_nodes",
        "freshness_s",
        "mean_accuracy_m",
        "stability",
        "reportable"
      ],
      "type": "object"
    }
  }
}

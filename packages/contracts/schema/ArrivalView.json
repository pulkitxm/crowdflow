{
  "$ref": "#/$defs/ArrivalView",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArrivalView": {
      "additionalProperties": false,
      "properties": {
        "gates": {
          "items": {
            "$ref": "#/$defs/GateChoice"
          },
          "type": "array"
        },
        "kind": {
          "const": "arrival",
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/LinkStatus"
        },
        "note": {
          "type": "string"
        },
        "now": {
          "type": "number"
        },
        "route": {
          "$ref": "#/$defs/Route"
        }
      },
      "required": [
        "now",
        "link",
        "route",
        "kind",
        "gates",
        "note"
      ],
      "type": "object"
    },
    "CrossingClosed": {
      "additionalProperties": false,
      "description": "Authored CrowdFlow wire contracts. Runtime derivations live beside them.",
      "properties": {
        "open": {
          "const": false,
          "type": "boolean"
        },
        "opens_at": {
          "description": "absolute unix seconds; None when no reopening time is known",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "open",
        "opens_at"
      ],
      "type": "object"
    },
    "CrossingNotice": {
      "additionalProperties": false,
      "description": "A timetable fact a spectator cannot infer by looking at the crossing.",
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossingOpen"
            },
            {
              "$ref": "#/$defs/CrossingClosed"
            }
          ]
        }
      },
      "required": [
        "name",
        "state"
      ],
      "type": "object"
    },
    "CrossingOpen": {
      "additionalProperties": false,
      "properties": {
        "closes_at": {
          "description": "absolute unix seconds; None when no closing time is known",
          "type": [
            "number",
            "null"
          ]
        },
        "open": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "open",
        "closes_at"
      ],
      "type": "object"
    },
    "GateChoice": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "walk_s": {
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        },
        "zone_id": {
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "name",
        "walk_s",
        "way_ahead"
      ],
      "type": "object"
    },
    "LinkStatus": {
      "additionalProperties": false,
      "description": "Freshness and reachability, stated rather than hidden.",
      "properties": {
        "mesh_peers": {
          "type": "number"
        },
        "online": {
          "type": "boolean"
        },
        "updated_at": {
          "description": "unix seconds of the newest observation behind the route",
          "type": "number"
        }
      },
      "required": [
        "online",
        "mesh_peers",
        "updated_at"
      ],
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "description": "Where the spectator is, where they are going and the walk between them.",
      "properties": {
        "from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "to": {
          "type": "string"
        },
        "total_walk_s": {
          "description": "door-to-door seconds from routing, including waits; never summed on the phone",
          "type": "number"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "steps",
        "total_walk_s"
      ],
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "description": "One already-priced leg of a route.",
      "properties": {
        "crossing": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossingNotice"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "to": {
          "description": "human-readable landmark from the circuit pack",
          "type": "string"
        },
        "walk_s": {
          "description": "walking seconds computed by the routing engine",
          "type": "number"
        },
        "way_ahead": {
          "$ref": "#/$defs/WayAhead"
        }
      },
      "required": [
        "id",
        "to",
        "walk_s",
        "way_ahead"
      ],
      "type": "object"
    },
    "WayAhead": {
      "enum": [
        "nominal",
        "building",
        "critical",
        "unknown"
      ],
      "type": "string"
    }
  }
}

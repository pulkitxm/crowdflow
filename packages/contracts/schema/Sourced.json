{
  "$ref": "#/$defs/Sourced",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Provenance": {
      "description": "Where a value came from. Never decorative — routing weights it.",
      "enum": [
        "osm",
        "venue_map",
        "f1_circuits",
        "authored",
        "measured",
        "assumed"
      ],
      "type": "string"
    },
    "Sourced": {
      "additionalProperties": false,
      "description": "A value with its provenance and, where applicable, its sample count.",
      "properties": {
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "samples": {
          "description": "observations behind a MEASURED value",
          "type": [
            "number",
            "null"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "provenance"
      ],
      "type": "object"
    }
  }
}

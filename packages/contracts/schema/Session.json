{
  "$ref": "#/$defs/Session",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Session": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "practice | qualifying | sprint | race | support | ceremony",
          "type": "string"
        },
        "start": {
          "description": "ISO 8601",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "start",
        "end"
      ],
      "type": "object"
    }
  }
}

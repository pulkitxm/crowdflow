{
  "$ref": "#/$defs/CoordinateFrame",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CoordinateFrame": {
      "additionalProperties": false,
      "description": "Local metric frame. Derived from the source bbox, never estimated.",
      "properties": {
        "origin_lat": {
          "type": "number"
        },
        "origin_lon": {
          "type": "number"
        },
        "rotation_deg": {
          "type": "number"
        },
        "track_bounds_m": {
          "description": "track extent (x, y)",
          "items": {},
          "type": "array"
        },
        "venue_bounds_m": {
          "description": "(min_x, min_y, max_x, max_y). Larger than the track: car parks, campsites and park-and-ride sit outside it. Sizing to the track clips arrival routes.",
          "items": {},
          "type": "array"
        }
      },
      "required": [
        "origin_lat",
        "origin_lon",
        "track_bounds_m",
        "venue_bounds_m"
      ],
      "type": "object"
    }
  }
}

{
  "name": "crowdflow-product-video",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "studio": "remotion studio video/index.ts",
    "render": "remotion render video/index.ts CrowdFlowProductVideo exports/crowdflow-product-video.mp4 --codec=h264 --crf=18 --audio-codec=aac --pixel-format=yuv420p --browser-executable=/usr/bin/google-chrome",
    "still": "remotion still video/index.ts CrowdFlowProductVideo exports/crowdflow-cover.png --frame=2650 --browser-executable=/usr/bin/google-chrome"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.509"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.509",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3"
  }
}

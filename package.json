{
  "name": "crowdflow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "codegen": "npm --workspace @crowdflow/contracts run codegen",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "crowdflow": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}

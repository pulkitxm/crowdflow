{
  "name": "crowdflow-mesh",
  "version": "0.1.0",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-http-bridge-refurbished",
          "react-native-multi-ble-peripheral",
          "react-native-udp",
          "react-native-wifi-p2p"
        ]
      }
    }
  },
  "main": "index.ts",
  "overrides": {
    "react-native-http-bridge-refurbished": {
      "react": "19.2.3"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-location": "~57.0.9",
    "expo-sensors": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-ble-plx": "^3.5.1",
    "react-native-http-bridge-refurbished": "^1.2.9",
    "react-native-multi-ble-peripheral": "^0.1.8",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-udp": "^4.1.7",
    "react-native-wifi-p2p": "^3.6.1",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
